{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "console": {
      "root": "apps/console",
      "framework": "vite"
    },
    "server": {
      "root": "apps/server",
      "framework": "hono",
      "entrypoint": "src/vercel.ts",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm --filter \"@openagentpack/kit-server...\" build",
      "functions": {
        "src/vercel.ts": {
          "includeFiles": "src/store/schema/history/**"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "console." } }],
      "destination": {
        "service": "console"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
