{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "hono",
      "entrypoint": "src/vercel.ts",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && rm -rf apps/server/dist && pnpm --filter \"@openagentpack/kit-server^...\" build && pnpm --filter @openagentpack/kit-server db:render",
      "functions": {
        "src/vercel.ts": {
          "includeFiles": "src/store/schema/history/**"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && KIT_CONSOLE_BASE=/console/ pnpm --filter \"console...\" build && pnpm --filter \"web...\" build && mkdir -p apps/web/dist/console && cp -R apps/console/dist/. apps/web/dist/console/",
      "rewrites": [
        { "source": "/console/assets/(.*)", "destination": "/console/assets/$1" },
        { "source": "/console", "destination": "/console/index.html" },
        { "source": "/console/", "destination": "/console/index.html" },
        { "source": "/console/(.*)", "destination": "/console/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
