{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "console": {
      "root": "apps/console",
      "framework": "vite",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && KIT_CONSOLE_BASE=/console/ pnpm --filter console... build"
    },
    "server": {
      "root": "apps/server",
      "framework": "hono",
      "entrypoint": "src/vercel.ts",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && rm -rf apps/server/dist && pnpm --filter \"@openagentpack/kit-server^...\" build && pnpm --filter @openagentpack/kit-server db:render",
      "functions": {
        "src/vercel.ts": {
          "includeFiles": "src/store/schema/history/**"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/console",
      "destination": {
        "service": "console",
        "path": "/"
      }
    },
    {
      "source": "/console/:path*",
      "destination": {
        "service": "console",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
